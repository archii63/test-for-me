#!/usr/bin/env python3

"""
Nexora - Repository Intelligence CLI

A lightweight, dependency-free tool for analyzing software repositories.

Features:
- Language statistics
- File and line counts
- Largest files detection
- Empty file detection
- Directory structure analysis
- JSON output for CI/CD pipelines
- Configurable ignored directories

Usage:
    python nexora.py /path/to/repository
    python nexora.py . --top 10
    python nexora.py . --json
"""

from __future__ import annotations

import argparse
import json
import os
from collections import Counter, defaultdict
from pathlib import Path


LANGUAGE_MAP = {
    ".py": "Python",
    ".js": "JavaScript",
    ".ts": "TypeScript",
    ".tsx": "TypeScript",
    ".jsx": "JavaScript",
    ".java": "Java",
    ".go": "Go",
    ".rs": "Rust",
    ".cpp": "C++",
    ".cc": "C++",
    ".c": "C",
    ".h": "C/C++ Header",
    ".hpp": "C++ Header",
    ".cs": "C#",
    ".php": "PHP",
    ".rb": "Ruby",
    ".swift": "Swift",
    ".kt": "Kotlin",
    ".kts": "Kotlin",
    ".sh": "Shell",
    ".bash": "Shell",
    ".zsh": "Shell",
    ".sql": "SQL",
    ".html": "HTML",
    ".css": "CSS",
    ".scss": "SCSS",
    ".vue": "Vue",
    ".dart": "Dart",
    ".lua": "Lua",
    ".r": "R",
    ".ex": "Elixir",
    ".exs": "Elixir",
    ".fs": "F#",
    ".fsx": "F#",
}

DEFAULT_IGNORED = {
    ".git",
    ".github",
    ".idea",
    ".vscode",
    "node_modules",
    "venv",
    ".venv",
    "env",
    ".env",
    "__pycache__",
    "dist",
    "build",
    "target",
    ".next",
    ".nuxt",
    "coverage",
}


def count_lines(path: Path) -> int:
    """Count lines safely using UTF-8 with replacement for invalid bytes."""
    try:
        with path.open("r", encoding="utf-8", errors="replace") as file:
            return sum(1 for _ in file)
    except (OSError, UnicodeError):
        return 0


def is_binary(path: Path) -> bool:
    """Detect likely binary files without external dependencies."""
    try:
        with path.open("rb") as file:
            chunk = file.read(8192)

        return b"\x00" in chunk
    except OSError:
        return True


def analyze_repository(
    root: Path,
    ignored: set[str],
    top_files: int,
) -> dict:
    """Analyze repository files and return structured statistics."""

    language_files = Counter()
    language_lines = Counter()
    directory_files = Counter()
    largest_files = []
    empty_files = []

    total_files = 0
    total_lines = 0
    skipped_files = 0

    for current_root, directories, files in os.walk(root):
        directories[:] = [
            directory
            for directory in directories
            if directory not in ignored
        ]

        current_path = Path(current_root)

        for filename in files:
            file_path = current_path / filename

            try:
                relative_path = file_path.relative_to(root)
            except ValueError:
                continue

            if any(part in ignored for part in relative_path.parts):
                continue

            if is_binary(file_path):
                skipped_files += 1
                continue

            extension = file_path.suffix.lower()
            language = LANGUAGE_MAP.get(extension, "Other")

            lines = count_lines(file_path)

            total_files += 1
            total_lines += lines

            language_files[language] += 1
            language_lines[language] += lines

            directory = str(relative_path.parent)
            if directory == ".":
                directory = "/"

            directory_files[directory] += 1

            try:
                size = file_path.stat().st_size
            except OSError:
                size = 0

            largest_files.append(
                {
                    "path": str(relative_path),
                    "size_bytes": size,
                    "lines": lines,
                    "language": language,
                }
            )

            if lines == 0:
                empty_files.append(str(relative_path))

    largest_files.sort(
        key=lambda item: item["size_bytes"],
        reverse=True,
    )

    largest_files = largest_files[:top_files]

    languages = []

    for language, files_count in language_files.most_common():
        languages.append(
            {
                "language": language,
                "files": files_count,
                "lines": language_lines[language],
            }
        )

    directories = [
        {
            "directory": directory,
            "files": count,
        }
        for directory, count in directory_files.most_common()
    ]

    return {
        "repository": root.name,
        "total_files": total_files,
        "total_lines": total_lines,
        "skipped_binary_files": skipped_files,
        "empty_files": empty_files,
        "languages": languages,
        "directories": directories,
        "largest_files": largest_files,
    }


def format_bytes(value: int) -> str:
    """Convert bytes into a readable format."""
    units = ["B", "KB", "MB", "GB"]

    size = float(value)

    for unit in units:
        if size < 1024:
            return f"{size:.1f} {unit}"

        size /= 1024

    return f"{size:.1f} TB"


def print_report(report: dict) -> None:
    """Print a human-readable repository report."""

    print()
    print("=" * 64)
    print(f"  NEXORA — Repository Intelligence")
    print("=" * 64)

    print(f"\nRepository : {report['repository']}")
    print(f"Files      : {report['total_files']:,}")
    print(f"Lines      : {report['total_lines']:,}")
    print(
        f"Binary     : {report['skipped_binary_files']:,} skipped"
    )

    print("\nLanguage Breakdown")
    print("-" * 64)

    for item in report["languages"]:
        print(
            f"{item['language']:<20}"
            f"{item['files']:>8} files"
            f"{item['lines']:>12,} lines"
        )

    print("\nLargest Files")
    print("-" * 64)

    for item in report["largest_files"]:
        print(
            f"{item['path']:<42}"
            f"{format_bytes(item['size_bytes']):>10}"
            f"{item['lines']:>10,} lines"
        )

    if report["empty_files"]:
        print("\nEmpty Files")
        print("-" * 64)

        for path in report["empty_files"]:
            print(f"  {path}")

    print("\nTop Directories")
    print("-" * 64)

    for item in report["directories"][:10]:
        print(
            f"{item['directory']:<45}"
            f"{item['files']:>8} files"
        )

    print("\n" + "=" * 64)
    print("  Analysis complete.")
    print("=" * 64)
    print()


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Nexora - Repository Intelligence CLI"
    )

    parser.add_argument(
        "path",
        nargs="?",
        default=".",
        help="Repository path (default: current directory)",
    )

    parser.add_argument(
        "--top",
        type=int,
        default=10,
        help="Number of largest files to display",
    )

    parser.add_argument(
        "--json",
        action="store_true",
        help="Output the report as JSON",
    )

    parser.add_argument(
        "--ignore",
        nargs="*",
        default=[],
        help="Additional directories to ignore",
    )

    return parser.parse_args()


def main() -> int:
    args = parse_arguments()

    root = Path(args.path).resolve()

    if not root.exists():
        print(f"Error: path does not exist: {root}")
        return 1

    if not root.is_dir():
        print(f"Error: path is not a directory: {root}")
        return 1

    if args.top < 1:
        print("Error: --top must be greater than zero.")
        return 1

    ignored = DEFAULT_IGNORED | set(args.ignore)

    report = analyze_repository(
        root=root,
        ignored=ignored,
        top_files=args.top,
    )

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print_report(report)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
